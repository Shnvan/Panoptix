# Panoptix environment schema
# PE-FIX: Added environment variable schema required by council audit

# Environment
APP_ENV=development
APP_PUBLIC_BASE_URL=https://cctv.example.test
CLOCK_SKEW_SECONDS=30
BREAK_GLASS_WINDOW_MINUTES=90

# Cloudflare Access JWT verification
CF_ACCESS_ISSUER=https://example.cloudflareaccess.com
CF_ACCESS_AUD_DASHBOARD=replace-me
CF_ACCESS_AUD_ADMIN=replace-me
CF_ACCESS_AUD_GATEWAY=replace-me
CF_ACCESS_JWKS_URL=https://example.cloudflareaccess.com/cdn-cgi/access/certs

# Local development auth only
ALLOW_DEV_AUTH=0
DEV_CF_JWT_SIGNING_KEY=replace-me-local-only

# Session/cookie secrets
SESSION_COOKIE_NAME=panoptix_session
SESSION_SIGNING_KEY=replace-me
CSRF_SIGNING_KEY=replace-me

# Database
DATABASE_URL=postgresql+psycopg://cctv_app_runtime:replace-me@localhost:5432/panoptix
MIGRATION_DATABASE_URL=postgresql+psycopg://cctv_migrator:replace-me@localhost:5432/panoptix

# LiveKit
LIVEKIT_MODE=cloud
LIVEKIT_CLOUD_URL=wss://replace-me.livekit.cloud
LIVEKIT_CLOUD_API_KEY=replace-me
LIVEKIT_CLOUD_API_SECRET=replace-me
LIVEKIT_FALLBACK_URL=wss://livekit.example.test
LIVEKIT_FALLBACK_API_KEY=replace-me
LIVEKIT_FALLBACK_API_SECRET=replace-me
LIVEKIT_WEBHOOK_SECRET=replace-me

# Gateway identity and command channel
GATEWAY_SERVICE_TOKEN=replace-me-gateway-only
GATEWAY_CONTROL_WS_PATH=/api/v1/gateway-control/ws
GATEWAY_COMMAND_SIGNING_KEY=replace-me
GATEWAY_HEARTBEAT_INTERVAL_SECONDS=10

# R2 backups and archives
R2_ACCOUNT_ID=replace-me
R2_BUCKET=panoptix-backups
R2_ACCESS_KEY_ID=replace-me
R2_SECRET_ACCESS_KEY=replace-me
AGE_PUBLIC_RECIPIENT=age1replace

# Observability
SENTRY_DSN=
BETTER_STACK_SOURCE_TOKEN=
UPTIMEROBOT_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Security headers / CSP
CSP_REPORT_URI=
LIVEKIT_CONNECT_SRC=wss://replace-me.livekit.cloud
